# Copie para .env e preencha. O .env nunca vai para o Git.

# ---------------- Radar: notificações no Telegram ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Candidatura: envio de e-mail ----------------
# false = MODO SIMULAÇÃO (padrão): gera um .eml em saida/ e não envia nada.
# true  = envia de verdade.
ENVIO_REAL=false

# Gmail: ative a verificação em 2 etapas e crie uma SENHA DE APP em
# https://myaccount.google.com/apppasswords  (não use sua senha normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu.email@gmail.com
SMTP_SENHA=
EMAIL_COPIA_PARA_MIM=false

# Limites anti-spam (Gmail grátis aceita ~500/dia, mas 20-30 protege sua reputação)
LIMITE_DIARIO_ENVIOS=30
INTERVALO_MIN_SEG=60
INTERVALO_MAX_SEG=180
DIAS_SEM_REPETIR_EMPRESA=30

# Modo `auto`: compatibilidade mínima (0-100) para enviar sem revisão
SCORE_MINIMO_AUTO=60

# ---------------- IA opcional (gratuita) ----------------
# Deixe vazio para usar só os modelos de texto (funciona 100% sem IA).
#   groq   -> chave grátis em https://console.groq.com
#   gemini -> chave grátis em https://aistudio.google.com/apikey
#   ollama -> local, sem chave (https://ollama.com)
IA_PROVEDOR=
IA_API_KEY=
IA_MODELO=

# Opcional: aumenta o limite da API do GitHub de 60 para 5.000 req/h
GITHUB_TOKEN=
